---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Projects - Marc Altabella">
	<main>
		<h1>Projects</h1>
		<ul>
			<li>
				<h3><a href="https://github.com/MarcAltabella/EDTH">EDTH</a></h3>
				<ul>
					<li>
						Passive RF drone-detection proof of concept for the EuroDefense Tech Hackathon:
						classifies drone type from spectrograms (ResNet18) with 3D angle-of-arrival
						triangulation.
					</li>
				</ul>
			</li>
			<li>
				<h3><a href="https://github.com/MarcAltabella/ProjectBarcelona">Karpa</a></h3>
				<ul>
					<li>
						Graph-first document-intelligence platform: ingests and classifies clinical and
						regulatory files, extracts relationships, and flags contradictions, duplicates, and
						outdated versions.
					</li>
					<li>2nd place, ProjectEurope Hackathon.</li>
				</ul>
			</li>
			<li>
				<h3><a href="https://github.com/MarcAltabella/Cala-OpenAI">Predict</a></h3>
				<ul>
					<li>
						Research platform connecting clinical research, trial data, and news in an
						interactive knowledge graph to spot healthcare developments and assess financial
						implications.
					</li>
					<li>3rd place, OpenAI x Cala hackathon.</li>
				</ul>
			</li>
			<li>
				<h3><a href="https://github.com/MarcAltabella/Findr">Findr</a></h3>
				<ul>
					<li>
						CNN built from scratch to recognize famous faces: data loading through training
						and prediction on unseen images.
					</li>
				</ul>
			</li>
			<li>
				<h3><a href="https://github.com/MarcAltabella/Centauri-HackEurope-26">Centauri</a></h3>
				<ul>
					<li>
						Multimodal browser copilot that adds a natural-language layer to any webpage, with
						agentic actions.
					</li>
					<li>Selected for the Scholars program, HackEurope 2026.</li>
				</ul>
			</li>
		</ul>
	</main>
</Layout>
