---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Projects - Marc Altabella">
    <main>
        <h1>Projects</h1>
        <ul>
            <li>
                <h3>
                    <a href="https://github.com/MarcAltabella/EDTH">EDTH</a>
                </h3>
                <ul>
                    <li>
                        Passive RF drone detection for the EuroDefense Tech
                        Hackathon, combining ResNet18 spectrogram classification
                        with 3D angle-of-arrival triangulation.
                    </li>
                </ul>
            </li>
            <li>
                <h3>
                    <a href="https://github.com/MarcAltabella/ProjectBarcelona">
                        Karpa
                    </a>
                </h3>
                <ul>
                    <li>
                        Graph-first document intelligence platform that extracts
                        relationships and detects contradictions, duplicates,
                        and outdated versions.
                    </li>
                    <li>2nd place, ProjectEurope Hackathon.</li>
                </ul>
            </li>
            <li>
                <h3>
                    <a href="https://github.com/MarcAltabella/Cala-OpenAI">
                        Predict
                    </a>
                </h3>
                <ul>
                    <li>
                        Interactive knowledge graph linking clinical trials,
                        biomedical research, and healthcare news to uncover
                        developments and assess financial impact.
                    </li>
                    <li>3rd place, OpenAI x Cala hackathon.</li>
                </ul>
            </li>
            <li>
                <h3>
                    <a href="https://github.com/MarcAltabella/Findr">Findr</a>
                </h3>
                <ul>
                    <li>
                        CNN built from scratch to built from scratch for
                        famous-face recognition.
                    </li>
                </ul>
            </li>
            <li>
                <h3>
                    <a href="https://github.com/MarcAltabella/Centauri-HackEurope-26">
                        Centauri
                    </a>
                </h3>
                <ul>
                    <li>
                        Multimodal browser copilot enabling natural-language
                        interaction and agentic actions across webpages.
                    </li>
                    <li>Selected for the Scholars program, HackEurope 2026.</li>
                </ul>
            </li>
        </ul>
    </main>
</Layout>
