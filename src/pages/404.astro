---
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<title>404 — Marc Altabella</title>
	</head>
	<body>
		<main class="not-found">
			<p class="not-found-code">404</p>
			<a href="/">Home</a>
		</main>
	</body>
</html>

<style>
	body {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 100dvh;
	}

	main.not-found {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		margin: 0;
		padding: 0;
		text-align: center;
	}

	.not-found-code {
		margin: 0;
		font-size: clamp(3rem, 12vw, 6rem);
		line-height: 1;
	}
</style>
