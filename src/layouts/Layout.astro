---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
}

const { title = 'Marc Altabella' } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Marc Altabella — software engineer, Barcelona." />
		<script is:inline>
			if (!sessionStorage.getItem('seen')) {
				document.documentElement.classList.add('anim');
				sessionStorage.setItem('seen', '1');
			}
		</script>
		<ClientRouter />
		<title>{title}</title>
	</head>
	<body>
		<header transition:persist>
			<img src="/ascii-art.png" alt="ASCII art of a mountain" width="1280" height="853" />
			<nav>
				<a href="/">Marc</a>
				<a href="/projects">Projects</a>
				<a href="https://github.com/MarcAltabella">GitHub</a>
				<a href="https://x.com/marcaltabella">X</a>
				<a href="https://www.linkedin.com/in/marcaltabella/">LinkedIn</a>
			</nav>
		</header>
		<slot />
	</body>
</html>
